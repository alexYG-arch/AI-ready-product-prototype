{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Figma Comment Map",
  "type": "object",
  "required": [
    "figma_comment_map"
  ],
  "properties": {
    "figma_comment_map": {
      "type": "object",
      "required": [
        "version",
        "owner",
        "authority_role",
        "forbidden_as_fact_source",
        "runtime_hash",
        "comments"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "authority_role": {
          "type": "string"
        },
        "forbidden_as_fact_source": {
          "type": "boolean",
          "const": true
        },
        "runtime_hash": {
          "type": "string"
        },
        "comments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "comment_semantic_id",
              "comment_role",
              "anchor",
              "message_template",
              "source_refs"
            ],
            "properties": {
              "comment_semantic_id": {
                "type": "string"
              },
              "comment_role": {
                "type": "string"
              },
              "anchor": {
                "type": "object"
              },
              "message_template": {
                "type": "string"
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          }
        }
      }
    }
  },
  "additionalProperties": true
}
