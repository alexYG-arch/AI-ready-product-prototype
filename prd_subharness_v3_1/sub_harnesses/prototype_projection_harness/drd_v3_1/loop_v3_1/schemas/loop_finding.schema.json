{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prd-harness.local/schemas/loop_finding.schema.json",
  "title": "Loop Finding",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "finding_id",
    "trigger_source",
    "severity",
    "failure_class",
    "affected_artifacts",
    "source_refs",
    "repair_hint_zh"
  ],
  "properties": {
    "finding_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string"
    },
    "stage": {
      "type": "string"
    },
    "trigger_source": {
      "enum": [
        "validator_result",
        "logic_sidecar_audit",
        "projection_report",
        "layout_analyzer",
        "skill_trace",
        "manual_review"
      ]
    },
    "severity": {
      "enum": [
        "info",
        "minor",
        "major",
        "blocker",
        "semantic_defect"
      ]
    },
    "failure_class": {
      "type": "string",
      "minLength": 1
    },
    "affected_stage_candidate": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affected_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "repair_hint_zh": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string"
    }
  }
}
