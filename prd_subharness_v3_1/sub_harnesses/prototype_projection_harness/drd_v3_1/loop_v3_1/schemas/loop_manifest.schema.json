{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prd-harness.local/schemas/loop_manifest.schema.json",
  "title": "Loop Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "run_id",
    "loop_version",
    "loop_profile",
    "input_lock_hash",
    "iterations",
    "final_status",
    "final_exit_reason"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "loop_version": {
      "const": "3.1"
    },
    "loop_profile": {
      "enum": [
        "LOOP_PROFILE_SIMPLE",
        "LOOP_PROFILE_STANDARD",
        "LOOP_PROFILE_COMPLEX"
      ]
    },
    "input_lock_hash": {
      "type": "string",
      "minLength": 1
    },
    "iterations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "iteration_id",
          "started_at",
          "input_hash",
          "findings",
          "repair_plan",
          "patch_set",
          "rerun_scope",
          "revalidation_results",
          "output_hash",
          "exit_decision"
        ],
        "properties": {
          "iteration_id": {},
          "started_at": {
            "type": "string"
          },
          "input_hash": {
            "type": "string"
          },
          "findings": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/loop_finding"
            }
          },
          "repair_plan": {
            "type": "object"
          },
          "patch_set": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/local_patch"
            }
          },
          "rerun_scope": {
            "type": "object",
            "required": [
              "scope"
            ],
            "additionalProperties": true
          },
          "revalidation_results": {
            "type": "object",
            "additionalProperties": true
          },
          "output_hash": {
            "type": "string"
          },
          "exit_decision": {
            "type": "string"
          }
        }
      }
    },
    "final_status": {
      "enum": [
        "pass",
        "blocked",
        "review_required",
        "stop_line",
        "failed",
        "gate_recorded"
      ]
    },
    "final_exit_reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "loop_finding": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "finding_id",
        "trigger_source",
        "severity",
        "failure_class",
        "affected_artifacts",
        "source_refs",
        "repair_hint_zh"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 1
        },
        "trigger_source": {
          "enum": [
            "validator_result",
            "logic_sidecar_audit",
            "projection_report",
            "layout_analyzer",
            "skill_trace",
            "manual_review"
          ]
        },
        "severity": {
          "enum": [
            "info",
            "minor",
            "major",
            "blocker",
            "semantic_defect"
          ]
        },
        "failure_class": {
          "type": "string",
          "minLength": 1
        },
        "affected_artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "repair_hint_zh": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "local_patch": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "patch_id",
        "patch_type",
        "source_finding_id",
        "before_hash",
        "operations",
        "after_hash",
        "writes_prd"
      ],
      "properties": {
        "patch_id": {
          "type": "string",
          "minLength": 1
        },
        "patch_type": {
          "type": "string",
          "minLength": 1
        },
        "source_finding_id": {
          "type": "string",
          "minLength": 1
        },
        "before_hash": {
          "type": "string",
          "minLength": 1
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": true
              }
            ]
          }
        },
        "after_hash": {
          "type": "string",
          "minLength": 1
        },
        "writes_prd": {
          "const": false
        }
      }
    }
  }
}
