{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prd-harness.local/schemas/model_figma_visual_comprehension.schema.json",
  "title": "Model Figma Visual Comprehension",
  "type": "object",
  "additionalProperties": false,
  "required": ["model_figma_visual_comprehension"],
  "properties": {
    "model_figma_visual_comprehension": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "version",
        "mode",
        "run_id",
        "model_called",
        "source_refs",
        "rule_trace",
        "human_understandable",
        "page_composition_ok",
        "interaction_explanations_ok",
        "carrier_alignment_ok",
        "state_matrix_detected",
        "source_alignment_ok",
        "blocker_findings"
      ],
      "properties": {
        "version": { "enum": ["3.1.3", "3.1.4", "3.2.2"] },
        "mode": { "const": "DRD_MODE" },
        "run_id": { "type": "string", "minLength": 1 },
        "model_called": { "type": "boolean" },
        "source_refs": { "$ref": "#/$defs/source_refs" },
        "rule_trace": { "$ref": "#/$defs/rule_trace" },
        "human_understandable": { "type": "boolean" },
        "page_composition_ok": { "type": "boolean" },
        "interaction_explanations_ok": { "type": "boolean" },
        "carrier_alignment_ok": { "type": "boolean" },
        "state_matrix_detected": { "type": "boolean" },
        "source_alignment_ok": { "type": "boolean" },
        "blocker_findings": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "rule_trace": {
      "type": "object",
      "required": ["rule_ids"],
      "additionalProperties": true,
      "properties": { "rule_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } }
    }
  }
}
