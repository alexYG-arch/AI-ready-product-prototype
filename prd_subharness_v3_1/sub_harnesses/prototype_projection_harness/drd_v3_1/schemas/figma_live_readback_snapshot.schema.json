{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prd-harness.local/schemas/figma_live_readback_snapshot.schema.json",
  "title": "Figma Live Readback Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["figma_live_readback_snapshot"],
  "properties": {
    "figma_live_readback_snapshot": {
      "type": "object",
      "additionalProperties": true,
      "required": ["version", "mode", "run_id", "audit_source", "source_refs", "rule_trace", "final_page", "nodes", "reactions"],
      "properties": {
        "version": { "enum": ["3.1.3", "3.1.4"] },
        "mode": { "const": "DRD_MODE" },
        "run_id": { "type": "string", "minLength": 1 },
        "audit_source": { "const": "figma_live_readback" },
        "source_refs": { "$ref": "#/$defs/source_refs" },
        "rule_trace": { "$ref": "#/$defs/rule_trace" },
        "final_page": {
          "type": "object",
          "required": ["page_id", "page_name", "top_level_node_names"],
          "additionalProperties": true
        },
        "nodes": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": true } },
        "reactions": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      }
    }
  },
  "$defs": {
    "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "rule_trace": {
      "type": "object",
      "required": ["rule_ids"],
      "additionalProperties": true,
      "properties": { "rule_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } }
    }
  }
}
