{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prototype Model Invocation Trace",
  "type": "object",
  "required": ["model_invocation_trace"],
  "properties": {
    "model_invocation_trace": {
      "type": "object",
      "required": [
        "version",
        "mode",
        "run_id",
        "invocation_id",
        "contract_id",
        "generator_id",
        "generator_kind",
        "provider",
        "execution_mode",
        "model_called",
        "status",
        "input_hashes",
        "output_refs",
        "completion_criteria_results"
      ],
      "properties": {
        "version": { "const": "3.1.1" },
        "mode": { "const": "DRD_MODE" },
        "run_id": { "type": "string", "minLength": 1 },
        "invocation_id": { "type": "string", "minLength": 1 },
        "contract_id": { "type": "string", "minLength": 1 },
        "generator_id": { "type": "string", "minLength": 1 },
        "generator_kind": { "const": "model" },
        "provider": { "type": "string", "minLength": 1 },
        "execution_mode": { "enum": ["off", "optional", "required"] },
        "model_called": { "type": "boolean" },
        "status": { "enum": ["pass", "review_required", "blocked", "skipped"] },
        "exit_code": { "type": ["integer", "null"] },
        "started_at": { "type": ["string", "null"] },
        "completed_at": { "type": ["string", "null"] },
        "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "input_hashes": { "type": "object" },
        "command": {
          "type": "array",
          "items": { "type": "string" }
        },
        "output_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "completion_criteria_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["criterion_id", "status", "evidence_refs"],
            "properties": {
              "criterion_id": { "type": "string", "minLength": 1 },
              "status": { "enum": ["pass", "blocked", "skipped", "review_required"] },
              "evidence_refs": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
