{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "System Handoff Map",
  "type": "object",
  "required": ["system_handoff_map"],
  "properties": {
    "system_handoff_map": {
      "type": "object",
      "required": ["version", "mode", "run_id", "source_refs", "handoffs"],
      "properties": {
        "version": { "const": "3.1.2" },
        "mode": { "const": "DRD_MODE" },
        "run_id": { "type": "string", "minLength": 1 },
        "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "handoffs": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
