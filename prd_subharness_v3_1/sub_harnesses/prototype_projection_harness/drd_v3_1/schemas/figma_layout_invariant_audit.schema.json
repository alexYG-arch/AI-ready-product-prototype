{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "figma_layout_invariant_audit.schema.json",
  "type": "object",
  "required": ["figma_layout_invariant_audit"],
  "properties": {
    "figma_layout_invariant_audit": {
      "type": "object",
      "required": ["version", "mode", "run_id", "status", "layout_checks", "mode_exclusion_checks", "overlay_checks", "blocker_findings", "source_refs", "rule_trace"],
      "properties": {
        "version": {"const": "3.2.3"},
        "mode": {"const": "DRD_MODE"},
        "run_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "blocked"]},
        "source_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "rule_trace": {"type": "object"},
        "layout_checks": {"type": "array", "items": {"type": "object"}},
        "relative_position_checks": {"type": "array", "items": {"type": "object"}},
        "mode_exclusion_checks": {"type": "array", "items": {"type": "object"}},
        "overlay_checks": {"type": "array", "items": {"type": "object"}},
        "blocker_findings": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
