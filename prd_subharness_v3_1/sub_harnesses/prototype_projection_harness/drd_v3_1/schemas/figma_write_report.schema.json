{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prd-harness.local/schemas/figma_write_report.schema.json",
  "title": "Figma Write Report",
  "type": "object",
  "required": ["figma_write_report"],
  "properties": {
    "figma_write_report": {
      "type": "object",
      "required": ["version", "mode", "run_id", "source_refs", "status", "written_nodes"],
      "additionalProperties": true,
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "mode": { "const": "DRD_MODE" },
        "run_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "blocked", "review_required"] },
        "source_refs": { "$ref": "#/$defs/source_refs" },
        "written_nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["node_id", "semantic_id", "source_refs"],
            "additionalProperties": true,
            "properties": {
              "source_refs": { "$ref": "#/$defs/source_refs" }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
