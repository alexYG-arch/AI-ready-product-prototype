{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prd-harness.local/schemas/model_interaction_state_machine_v3_2.schema.json",
  "title": "Model Interaction State Machine v3.2",
  "type": "object",
  "required": ["model_interaction_state_machine"],
  "properties": {
    "model_interaction_state_machine": {
      "type": "object",
      "required": ["version", "mode", "run_id", "source_refs", "states", "transitions"],
      "additionalProperties": true,
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "mode": { "const": "DRD_MODE" },
        "run_id": { "type": "string", "minLength": 1 },
        "source_refs": { "$ref": "#/$defs/source_refs" },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["state_id", "surface_ref", "source_refs"],
            "additionalProperties": true,
            "properties": {
              "source_refs": { "$ref": "#/$defs/source_refs" }
            }
          }
        },
        "transitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["transition_id", "source_state", "trigger", "guard_or_no_guard_reason", "target_state_or_effect", "feedback_timing", "source_refs"],
            "additionalProperties": true,
            "properties": {
              "source_refs": { "$ref": "#/$defs/source_refs" }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
