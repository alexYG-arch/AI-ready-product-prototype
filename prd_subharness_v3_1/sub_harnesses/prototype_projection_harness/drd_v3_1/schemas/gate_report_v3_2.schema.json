{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prd-harness.local/schemas/gate_report_v3_2.schema.json",
  "title": "Gate Report v3.2",
  "type": "object",
  "required": ["gate_report"],
  "properties": {
    "gate_report": {
      "type": "object",
      "required": ["version", "mode", "run_id", "gate_id", "status", "source_refs", "findings"],
      "additionalProperties": true,
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "mode": { "const": "DRD_MODE" },
        "run_id": { "type": "string", "minLength": 1 },
        "gate_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "blocked", "review_required"] },
        "source_refs": { "$ref": "#/$defs/source_refs" },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["finding_id", "severity", "message_zh", "source_refs"],
            "additionalProperties": true,
            "properties": {
              "source_refs": { "$ref": "#/$defs/source_refs" }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
