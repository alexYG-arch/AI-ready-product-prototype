{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prd-harness.local/schemas/prototype_ui_blueprint.schema.json",
  "title": "Prototype UI Blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": ["prototype_ui_blueprint"],
  "properties": {
    "prototype_ui_blueprint": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "version",
        "mode",
        "run_id",
        "generated_by",
        "candidate_marker",
        "source_refs",
        "rule_trace",
        "input_artifacts",
        "primitive_contract",
        "surface_primitives",
        "region_primitives",
        "control_primitives",
        "writer_input",
        "screens",
        "system_handoff_surfaces",
        "prototype_interactions"
      ],
      "properties": {
        "version": { "const": "3.1.3" },
        "mode": { "const": "DRD_MODE" },
        "run_id": { "type": "string", "minLength": 1 },
        "generated_by": { "const": "prototype_ui_blueprint_generator_v3_1_3" },
        "candidate_marker": { "const": "candidate_projection" },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "rule_trace": { "$ref": "#/$defs/rule_traced_object" },
        "input_artifacts": {
          "type": "object",
          "required": ["payload", "figma_render_plan", "interaction_carrier_map", "system_handoff_map", "user_operation_chain"],
          "additionalProperties": true
        },
        "primitive_contract": {
          "type": "object",
          "required": ["allowed_primitives", "surface_primitives", "region_primitives", "control_primitives", "forbidden_primitives", "color_policy", "sds_binding_required", "primitive_path_required"],
          "additionalProperties": true,
          "properties": {
            "allowed_primitives": {
              "type": "array",
              "minItems": 6,
              "items": { "$ref": "#/$defs/ui_primitive" }
            },
            "forbidden_primitives": {
              "type": "array",
              "contains": { "const": "button" }
            },
            "color_policy": { "const": "black_white_gray_only" },
            "sds_binding_required": { "const": true }
            ,
            "primitive_path_required": { "const": true }
          }
        },
        "surface_primitives": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/ui_primitive" }
        },
        "region_primitives": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/ui_primitive" }
        },
        "control_primitives": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/ui_primitive" }
        },
        "writer_input": {
          "type": "object",
          "required": ["path", "format", "compact_input_forbidden"],
          "additionalProperties": true,
          "properties": {
            "format": { "const": "full_ui_blueprint_json" },
            "compact_input_forbidden": { "const": true }
          }
        },
        "screens": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/screen" }
        },
        "system_handoff_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/handoff_surface" }
        },
        "prototype_interactions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/prototype_interaction" }
        }
      }
    }
  },
  "$defs": {
    "ui_primitive": {
      "enum": [
        "phone_shell",
        "host_chat_surface",
        "keyboard_ai_panel",
        "app_content_surface",
        "system_picker_overlay",
        "modal_surface",
        "inline_feedback_surface",
        "result_surface",
        "status_bar",
        "host_message_area",
        "keyboard_toolbar_region",
        "picker_header",
        "picker_grid_region",
        "picker_action_bar",
        "picker_feedback_region",
        "result_summary_region",
        "member_unlock_region",
        "interaction_explanation_region",
        "toolbar_action",
        "image_tile",
        "confirm_action",
        "cancel_action",
        "level_option",
        "primary_action",
        "disabled_action",
        "retry_action",
        "copy_action",
        "loading_indicator",
        "toast_notice",
        "keyboard_panel",
        "toolbar",
        "media_picker",
        "image_grid",
        "selection_counter",
        "primary_button",
        "disabled_button",
        "level_selector",
        "result_card",
        "loading_state",
        "error_notice",
        "toast",
        "handoff_overlay",
        "input_field",
        "display_text"
      ]
    },
    "rule_traced_object": {
      "type": "object",
      "additionalProperties": true,
      "required": ["rule_ids"],
      "properties": {
        "rule_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "screen": {
      "type": "object",
      "additionalProperties": true,
      "required": ["screen_id", "surface_primitive", "frames", "source_refs", "rule_ids"],
      "properties": {
        "screen_id": { "type": "string", "minLength": 1 },
        "surface_primitive": { "$ref": "#/$defs/ui_primitive" },
        "frames": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/frame" }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "rule_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": true,
      "required": ["frame_id", "frame_surface", "surface_primitive", "layout_regions", "composition_contract", "components", "source_refs", "rule_ids"],
      "properties": {
        "frame_id": { "type": "string", "minLength": 1 },
        "frame_surface": { "type": "string", "minLength": 1 },
        "surface_primitive": { "$ref": "#/$defs/ui_primitive" },
        "layout_regions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component" }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "rule_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "component_id",
        "ui_primitive",
        "ui_primitive_ref",
        "primitive_path",
        "layout_region",
        "visual_affordance",
        "expected_figma_node_type",
        "interaction_hotspot_node_role",
        "must_attach_reaction_to_component",
        "source_refs",
        "rule_ids"
      ],
      "properties": {
        "component_id": { "type": "string", "minLength": 1 },
        "ui_primitive": { "$ref": "#/$defs/ui_primitive" },
        "ui_primitive_ref": { "type": "string", "minLength": 1 },
        "primitive_path": {
          "type": "object",
          "required": ["surface", "region", "control", "surface_type"],
          "additionalProperties": true
        },
        "layout_region": { "type": "string", "minLength": 1 },
        "visual_affordance": {
          "type": "object",
          "required": ["kind", "description_zh"],
          "additionalProperties": true
        },
        "expected_figma_node_type": { "type": "string", "minLength": 1 },
        "interaction_hotspot_node_role": { "type": "string", "minLength": 1 },
        "must_attach_reaction_to_component": { "type": "boolean" },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "rule_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "handoff_surface": {
      "type": "object",
      "additionalProperties": true,
      "required": ["handoff_id", "ui_primitive", "structure_primitives", "must_not_be_aggregated_summary", "source_refs", "rule_ids"],
      "properties": {
        "handoff_id": { "type": "string", "minLength": 1 },
        "ui_primitive": { "$ref": "#/$defs/ui_primitive" },
        "structure_primitives": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/ui_primitive" }
        },
        "must_not_be_aggregated_summary": { "const": true },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "rule_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "prototype_interaction": {
      "type": "object",
      "additionalProperties": true,
      "required": ["interaction_id", "source_component_id", "hotspot_strategy", "source_refs", "rule_ids"],
      "properties": {
        "interaction_id": { "type": "string", "minLength": 1 },
        "source_component_id": { "type": "string", "minLength": 1 },
        "hotspot_strategy": {
          "enum": ["attach_to_component", "transparent_hotspot_overlay", "none_terminal_stay"]
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "rule_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
