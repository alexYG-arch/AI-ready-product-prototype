{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prototype Review View Model",
  "type": "object",
  "required": ["prototype_review_view_model"],
  "properties": {
    "prototype_review_view_model": {
      "type": "object",
      "required": ["version", "mode", "run_id", "status", "source_refs", "pages", "page_flow_edges", "same_surface_state_changes", "system_handoff_chains"],
      "properties": {
        "version": { "const": "3.1.2" },
        "mode": { "const": "DRD_MODE" },
        "run_id": { "type": "string", "minLength": 1 },
        "status": { "const": "ready_for_human_review" },
        "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "pages": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "page_flow_edges": { "type": "array", "items": { "type": "object" } },
        "same_surface_state_changes": { "type": "array", "items": { "type": "object" } },
        "system_handoff_chains": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
