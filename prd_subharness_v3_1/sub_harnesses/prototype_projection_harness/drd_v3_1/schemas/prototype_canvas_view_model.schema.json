{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prd-harness.local/schemas/prototype_canvas_view_model.schema.json",
  "title": "Prototype Canvas View Model",
  "type": "object",
  "additionalProperties": false,
  "required": ["prototype_canvas_view_model"],
  "properties": {
    "prototype_canvas_view_model": {
      "type": "object",
      "additionalProperties": true,
      "required": ["version", "mode", "run_id", "source_refs", "rule_trace", "writer_consumes_this_model", "scenes"],
      "properties": {
        "version": { "const": "3.1.3" },
        "mode": { "const": "DRD_MODE" },
        "run_id": { "type": "string", "minLength": 1 },
        "source_refs": { "$ref": "#/$defs/source_refs" },
        "rule_trace": { "$ref": "#/$defs/rule_trace" },
        "writer_consumes_this_model": { "const": true },
        "scenes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scene_view" } }
      }
    }
  },
  "$defs": {
    "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "rule_trace": {
      "type": "object",
      "required": ["rule_ids"],
      "additionalProperties": true,
      "properties": { "rule_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } }
    },
    "scene_view": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "scene_id",
        "page_name_zh",
        "page_purpose_zh",
        "state_description_zh",
        "carrier_description_zh",
        "element_groups",
        "interaction_explanations",
        "source_refs",
        "rule_ids"
      ],
      "properties": {
        "scene_id": { "type": "string", "pattern": "^PROTOTYPE-SCENE:" },
        "page_name_zh": { "type": "string", "minLength": 1 },
        "page_purpose_zh": { "type": "string", "minLength": 1 },
        "state_description_zh": { "type": "string", "minLength": 1 },
        "carrier_description_zh": { "type": "string", "minLength": 1 },
        "element_groups": {
          "type": "object",
          "required": ["display_elements", "operation_elements", "input_selection_elements", "feedback_prompt_elements", "identity_marker_elements"],
          "additionalProperties": true
        },
        "interaction_explanations": { "type": "array", "items": { "$ref": "#/$defs/interaction_explanation" } },
        "source_refs": { "$ref": "#/$defs/source_refs" },
        "rule_ids": { "$ref": "#/$defs/source_refs" }
      }
    },
    "interaction_explanation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["interaction_id", "visible_control_zh", "before_condition_zh", "after_action_zh", "transition_kind", "operation_chain_zh", "source_refs", "rule_ids"],
      "properties": {
        "interaction_id": { "type": "string", "minLength": 1 },
        "visible_control_zh": { "type": "string", "minLength": 1 },
        "before_condition_zh": { "type": "string", "minLength": 1 },
        "after_action_zh": { "type": "string", "minLength": 1 },
        "transition_kind": { "type": "string", "minLength": 1 },
        "operation_chain_zh": { "type": "string", "minLength": 1 },
        "source_refs": { "$ref": "#/$defs/source_refs" },
        "rule_ids": { "$ref": "#/$defs/source_refs" }
      }
    }
  }
}
