{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prd-harness.local/schemas/figma_visual_reverse_inference.schema.json",
  "title": "Figma Visual Reverse Inference",
  "type": "object",
  "additionalProperties": false,
  "required": ["figma_visual_reverse_inference"],
  "properties": {
    "figma_visual_reverse_inference": {
      "type": "object",
      "additionalProperties": true,
      "required": ["version", "mode", "run_id", "status", "source_refs", "rule_trace", "inferred_pages", "inferred_carriers", "inferred_interactions", "prototype_shape", "blocker_findings"],
      "properties": {
        "version": { "const": "3.2.1" },
        "mode": { "const": "DRD_MODE" },
        "run_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "blocked"] },
        "source_refs": { "$ref": "#/$defs/source_refs" },
        "rule_trace": { "$ref": "#/$defs/rule_trace" },
        "inferred_pages": { "type": "array", "items": { "type": "object" } },
        "inferred_carriers": { "type": "array", "items": { "type": "object" } },
        "inferred_interactions": { "type": "array", "items": { "type": "object" } },
        "prototype_shape": { "type": "object", "additionalProperties": true },
        "blocker_findings": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "rule_trace": {
      "type": "object",
      "required": ["rule_ids"],
      "additionalProperties": true,
      "properties": { "rule_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } }
    }
  }
}
