{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prd-harness.local/schemas/prototype_playback_contract.schema.json",
  "title": "Prototype Playback Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["prototype_playback_contract"],
  "properties": {
    "prototype_playback_contract": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "version",
        "mode",
        "run_id",
        "playable_profile",
        "source_refs",
        "rule_trace",
        "input_artifacts",
        "surface_mode_contract_ref",
        "layout_invariant_contract_ref",
        "runtime_rule_execution_trace_ref",
        "forbidden_writer_sources",
        "model_status",
        "required_visual_containers",
        "pages",
        "page_states",
        "overlays",
        "controls",
        "interaction_flows",
        "system_handoffs",
        "interaction_explanations",
        "source_alignment_requirements"
      ],
      "properties": {
        "version": { "const": "3.2.3" },
        "mode": { "const": "DRD_MODE" },
        "run_id": { "type": "string", "minLength": 1 },
        "playable_profile": { "const": "PLAYABLE_PROTOTYPE_WRITE" },
        "source_refs": { "$ref": "#/$defs/source_refs" },
        "rule_trace": { "$ref": "#/$defs/rule_trace" },
        "input_artifacts": { "type": "object", "additionalProperties": true },
        "forbidden_writer_sources": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "model_status": {
          "type": "object",
          "required": ["all_logic_consistent", "all_prototype_renderable", "blocking_unknown_count"],
          "additionalProperties": true,
          "properties": {
            "all_logic_consistent": { "type": "boolean" },
            "all_prototype_renderable": { "type": "boolean" },
            "blocking_unknown_count": { "type": "integer", "minimum": 0 }
          }
        },
        "required_visual_containers": { "$ref": "#/$defs/string_array" },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["page_id", "page_name_zh", "page_purpose_zh", "carrier_type", "layout_regions", "default_active_mode_id", "visible_regions", "hidden_regions", "source_refs", "rule_ids"],
            "properties": {
              "page_id": { "type": "string", "minLength": 1 },
              "page_name_zh": { "type": "string", "minLength": 1 },
              "page_purpose_zh": { "type": "string", "minLength": 1 },
              "carrier_type": { "type": "string", "minLength": 1 },
              "layout_regions": { "$ref": "#/$defs/string_array" },
              "default_active_mode_id": { "type": "string", "minLength": 1 },
              "visible_regions": { "$ref": "#/$defs/string_array" },
              "hidden_regions": { "type": "array", "items": { "type": "string" } },
              "source_refs": { "$ref": "#/$defs/source_refs" },
              "rule_ids": { "$ref": "#/$defs/rule_ids" }
            }
          }
        },
        "page_states": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["state_id", "page_id", "surface_id", "active_mode_id", "visible_regions", "hidden_regions", "state_visibility", "state_summary_zh", "source_refs", "rule_ids"]
          }
        },
        "overlays": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "hidden_targets": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "controls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["control_id", "page_id", "region_id", "control_kind", "primitive_type", "visible_text_zh", "source_refs", "rule_ids"],
            "properties": {
              "control_id": { "type": "string", "minLength": 1 },
              "page_id": { "type": "string", "minLength": 1 },
              "region_id": { "type": "string", "minLength": 1 },
              "control_kind": { "type": "string", "minLength": 1 },
              "primitive_type": { "type": "string", "minLength": 1 },
              "visible_text_zh": { "type": "string", "minLength": 1 },
              "source_refs": { "$ref": "#/$defs/source_refs" },
              "rule_ids": { "$ref": "#/$defs/rule_ids" }
            }
          }
        },
        "interaction_flows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["interaction_id", "source_page_id", "source_control_id", "target_page_id", "transition_kind", "reaction_target", "source_refs", "rule_ids"],
            "properties": {
              "reaction_target": {
                "type": "object",
                "required": ["target_kind", "target_id", "must_be_top_level_frame", "fallback_strategy"],
                "additionalProperties": true
              },
              "source_refs": { "$ref": "#/$defs/source_refs" },
              "rule_ids": { "$ref": "#/$defs/rule_ids" }
            }
          }
        },
        "system_handoffs": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "interaction_explanations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["explanation_id", "interaction_id", "page_id", "text_zh", "source_refs", "rule_ids"]
          }
        },
        "source_alignment_requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["requirement_id", "source_state_id", "expected_visible_texts", "expected_surface", "source_refs", "rule_ids"]
          }
        }
      }
    }
  },
  "$defs": {
    "string_array": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "rule_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "rule_trace": {
      "type": "object",
      "required": ["rule_ids"],
      "additionalProperties": true,
      "properties": { "rule_ids": { "$ref": "#/$defs/rule_ids" } }
    }
  }
}
