{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prd-harness.local/schemas/model_user_journey_v3_2.schema.json",
  "title": "Model User Journey v3.2",
  "type": "object",
  "required": ["model_user_journey"],
  "properties": {
    "model_user_journey": {
      "type": "object",
      "required": ["version", "mode", "run_id", "source_refs", "chains"],
      "additionalProperties": true,
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "mode": { "const": "DRD_MODE" },
        "run_id": { "type": "string", "minLength": 1 },
        "source_refs": { "$ref": "#/$defs/source_refs" },
        "chains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["chain_id", "steps", "source_refs"],
            "additionalProperties": true,
            "properties": {
              "chain_id": { "type": "string", "minLength": 1 },
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["step_id", "actor", "surface_ref", "action_zh", "object_zh", "result_zh", "source_refs"],
                  "additionalProperties": true,
                  "properties": {
                    "source_refs": { "$ref": "#/$defs/source_refs" }
                  }
                }
              },
              "source_refs": { "$ref": "#/$defs/source_refs" }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
