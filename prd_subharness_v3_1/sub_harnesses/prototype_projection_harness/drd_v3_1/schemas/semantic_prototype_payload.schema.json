{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prd-harness.local/schemas/semantic_prototype_payload.schema.json",
  "title": "Semantic Prototype Payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["semantic_prototype_payload"],
  "properties": {
    "semantic_prototype_payload": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "version",
        "mode",
        "run_id",
        "generated_by",
        "candidate_marker",
        "playable_profile",
        "source_refs",
        "rule_trace",
        "input_artifacts",
        "compression_guard",
        "pages",
        "interactions"
      ],
      "properties": {
        "version": { "const": "3.2.0" },
        "mode": { "const": "DRD_MODE" },
        "run_id": { "type": "string", "minLength": 1 },
        "generated_by": { "const": "semantic_prototype_payload_generator_v3_2" },
        "candidate_marker": { "const": "candidate_projection" },
        "playable_profile": { "const": "PLAYABLE_PROTOTYPE_WRITE" },
        "forbidden_as_fact_source": { "const": true },
        "source_refs": { "$ref": "#/$defs/source_refs" },
        "rule_trace": { "$ref": "#/$defs/rule_trace" },
        "input_artifacts": { "type": "object", "additionalProperties": true },
        "compression_guard": {
          "type": "object",
          "required": ["compact_payload_forbidden", "drd_board_packets_forbidden", "review_md_as_source_forbidden", "documentation_dominance_forbidden"],
          "additionalProperties": true,
          "properties": {
            "compact_payload_forbidden": { "const": true },
            "drd_board_packets_forbidden": { "const": true },
            "review_md_as_source_forbidden": { "const": true },
            "documentation_dominance_forbidden": { "const": true }
          }
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/page" }
        },
        "interactions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/interaction" }
        }
      }
    }
  },
  "$defs": {
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "rule_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "rule_trace": {
      "type": "object",
      "required": ["rule_ids"],
      "additionalProperties": true,
      "properties": {
        "rule_ids": { "$ref": "#/$defs/rule_ids" }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": true,
      "required": ["page_id", "page_name_zh", "page_purpose_zh", "carrier_zh", "layout_zh", "user_task_zh", "regions", "source_refs", "rule_ids"],
      "properties": {
        "page_id": { "type": "string", "minLength": 1 },
        "page_name_zh": { "type": "string", "minLength": 2 },
        "page_purpose_zh": { "type": "string", "minLength": 8 },
        "carrier_zh": { "type": "string", "minLength": 4 },
        "layout_zh": { "type": "string", "minLength": 8 },
        "user_task_zh": { "type": "string", "minLength": 4 },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/region" }
        },
        "source_refs": { "$ref": "#/$defs/source_refs" },
        "rule_ids": { "$ref": "#/$defs/rule_ids" }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": true,
      "required": ["region_id", "region_name_zh", "primitive_type", "description_zh", "elements", "source_refs", "rule_ids"],
      "properties": {
        "region_id": { "type": "string", "minLength": 1 },
        "region_name_zh": { "type": "string", "minLength": 2 },
        "primitive_type": { "type": "string", "minLength": 1 },
        "description_zh": { "type": "string", "minLength": 4 },
        "elements": {
          "type": "array",
          "items": { "$ref": "#/$defs/element" }
        },
        "source_refs": { "$ref": "#/$defs/source_refs" },
        "rule_ids": { "$ref": "#/$defs/rule_ids" }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": true,
      "required": ["element_id", "element_name_zh", "primitive_type", "visible_text_zh", "description_zh", "source_refs", "rule_ids"],
      "properties": {
        "element_id": { "type": "string", "minLength": 1 },
        "element_name_zh": { "type": "string", "minLength": 2 },
        "primitive_type": { "type": "string", "minLength": 1 },
        "visible_text_zh": { "type": "string", "minLength": 1 },
        "description_zh": { "type": "string", "minLength": 4 },
        "interaction_targets": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "source_refs": { "$ref": "#/$defs/source_refs" },
        "rule_ids": { "$ref": "#/$defs/rule_ids" }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": true,
      "required": ["interaction_id", "source_element_id", "user_visible_trigger_zh", "precondition_zh", "carrier_zh", "next_step_zh", "transition_kind", "source_refs", "rule_ids"],
      "properties": {
        "interaction_id": { "type": "string", "minLength": 1 },
        "source_element_id": { "type": "string", "minLength": 1 },
        "target_page_id": { "type": "string" },
        "user_visible_trigger_zh": { "type": "string", "minLength": 2 },
        "precondition_zh": { "type": "string", "minLength": 2 },
        "carrier_zh": { "type": "string", "minLength": 4 },
        "next_step_zh": { "type": "string", "minLength": 4 },
        "transition_kind": {
          "enum": ["same_page_state_change", "page_navigation", "system_handoff", "overlay_open", "inline_feedback"]
        },
        "source_refs": { "$ref": "#/$defs/source_refs" },
        "rule_ids": { "$ref": "#/$defs/rule_ids" }
      }
    }
  }
}
