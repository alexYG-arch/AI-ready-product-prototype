{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DRD v3.1 Local Materialization Patch",
  "type": "object",
  "required": ["local_materialization_patch"],
  "properties": {
    "local_materialization_patch": {
      "type": "object",
      "required": ["patches"],
      "properties": {
        "version": { "type": "string" },
        "mode": { "type": "string" },
        "patches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "patch_id",
              "source_audit_finding",
              "patch_scope",
              "operations",
              "writes_prd",
              "source_refs"
            ],
            "properties": {
              "patch_id": { "type": "string", "minLength": 1 },
              "patch_id_zh": { "type": "string" },
              "source_audit_finding": { "type": "string", "minLength": 1 },
              "patch_scope": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "operations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["operation_type", "target"],
                  "properties": {
                    "operation_type": { "type": "string", "minLength": 1 },
                    "target": { "type": "string", "minLength": 1 },
                    "description_zh": { "type": "string" },
                    "source_refs": {
                      "type": "array",
                      "items": { "type": "string", "minLength": 1 }
                    }
                  },
                  "additionalProperties": true
                }
              },
              "writes_prd": { "const": false },
              "source_refs": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "validator_results": { "type": "array" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
