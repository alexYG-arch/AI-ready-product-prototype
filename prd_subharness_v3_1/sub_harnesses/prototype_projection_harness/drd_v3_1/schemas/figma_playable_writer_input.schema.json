{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prd-harness.local/schemas/figma_playable_writer_input.schema.json",
  "title": "Figma Playable Writer Input",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "format",
    "version",
    "run_id",
    "source_refs",
    "rule_trace",
    "compression_guard",
    "playable_prototype_model",
    "playable_model",
    "scene_views_by_id",
    "writer_contract"
  ],
  "properties": {
    "format": { "const": "playable_prototype_writer_input_v3_1_4" },
    "version": { "const": "3.1.4" },
    "run_id": { "type": "string", "minLength": 1 },
    "source_refs": { "$ref": "#/$defs/source_refs" },
    "rule_trace": { "$ref": "#/$defs/rule_trace" },
    "compression_guard": {
      "type": "object",
      "required": ["compact_tuple_input_forbidden", "direct_payload_scan_forbidden", "state_matrix_forbidden"],
      "additionalProperties": true,
      "properties": {
        "compact_tuple_input_forbidden": { "const": true },
        "direct_payload_scan_forbidden": { "const": true },
        "state_matrix_forbidden": { "const": true }
      }
    },
    "playable_prototype_model": {
      "type": "object",
      "required": ["path", "sha256"],
      "additionalProperties": true
    },
    "playable_model": { "type": "object", "additionalProperties": true },
    "scene_views_by_id": { "type": "object", "additionalProperties": true },
    "writer_contract": {
      "type": "object",
      "required": ["writer_must_consume_playable_model", "hidden_targets_must_not_render_as_visible_matrix", "live_visual_gate_required"],
      "additionalProperties": true,
      "properties": {
        "writer_must_consume_playable_model": { "const": true },
        "hidden_targets_must_not_render_as_visible_matrix": { "const": true },
        "live_visual_gate_required": { "const": true }
      }
    }
  },
  "$defs": {
    "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "rule_trace": {
      "type": "object",
      "required": ["rule_ids"],
      "additionalProperties": true,
      "properties": {
        "rule_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
