{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prd-harness.local/schemas/figma_screenshot_manifest.schema.json",
  "title": "Figma Screenshot Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["figma_screenshot_manifest"],
  "properties": {
    "figma_screenshot_manifest": {
      "type": "object",
      "additionalProperties": true,
      "required": ["version", "mode", "run_id", "source_refs", "rule_trace", "screenshots"],
      "properties": {
        "version": { "const": "3.1.3" },
        "mode": { "const": "DRD_MODE" },
        "run_id": { "type": "string", "minLength": 1 },
        "source_refs": { "$ref": "#/$defs/source_refs" },
        "rule_trace": { "$ref": "#/$defs/rule_trace" },
        "screenshots": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      }
    }
  },
  "$defs": {
    "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "rule_trace": {
      "type": "object",
      "required": ["rule_ids"],
      "additionalProperties": true,
      "properties": { "rule_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } }
    }
  }
}
