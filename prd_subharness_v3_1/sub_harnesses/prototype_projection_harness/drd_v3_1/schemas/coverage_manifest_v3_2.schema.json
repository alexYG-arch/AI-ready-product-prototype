{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prd-harness.local/schemas/coverage_manifest_v3_2.schema.json",
  "title": "Coverage Manifest v3.2",
  "type": "object",
  "required": ["coverage_manifest"],
  "properties": {
    "coverage_manifest": {
      "type": "object",
      "required": ["version", "mode", "run_id", "source_refs", "coverage_items", "status"],
      "additionalProperties": true,
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "mode": { "const": "DRD_MODE" },
        "run_id": { "type": "string", "minLength": 1 },
        "source_refs": { "$ref": "#/$defs/source_refs" },
        "status": { "enum": ["pass", "blocked", "review_required"] },
        "coverage_items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["source_ref", "artifact_refs", "covered"],
            "additionalProperties": true
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
