{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prd-harness.local/schemas/final_materialization_v3_2.schema.json",
  "title": "Final Materialization v3.2",
  "type": "object",
  "required": ["final_materialization"],
  "properties": {
    "final_materialization": {
      "type": "object",
      "required": ["version", "mode", "run_id", "source_refs", "artifacts"],
      "additionalProperties": true,
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "mode": { "const": "DRD_MODE" },
        "run_id": { "type": "string", "minLength": 1 },
        "source_refs": { "$ref": "#/$defs/source_refs" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["artifact_id", "path", "source_refs"],
            "additionalProperties": true,
            "properties": {
              "source_refs": { "$ref": "#/$defs/source_refs" }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
