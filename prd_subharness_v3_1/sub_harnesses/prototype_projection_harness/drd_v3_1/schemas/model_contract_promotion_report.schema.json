{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model Contract Promotion Report",
  "type": "object",
  "required": ["model_contract_promotion_report"],
  "properties": {
    "model_contract_promotion_report": {
      "type": "object",
      "required": ["version", "mode", "run_id", "status", "contract_profile_id", "source_refs", "writes_prd", "figma_written"],
      "properties": {
        "version": { "const": "3.1.2" },
        "mode": { "const": "DRD_MODE" },
        "run_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["promoted", "base_contract", "blocked"] },
        "contract_profile_id": { "type": "string", "minLength": 1 },
        "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "writes_prd": { "const": false },
        "figma_written": { "const": false }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
