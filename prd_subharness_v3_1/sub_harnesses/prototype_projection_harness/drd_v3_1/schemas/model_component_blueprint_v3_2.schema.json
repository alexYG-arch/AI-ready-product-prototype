{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prd-harness.local/schemas/model_component_blueprint_v3_2.schema.json",
  "title": "Model Component Blueprint v3.2",
  "type": "object",
  "required": ["model_component_blueprint"],
  "properties": {
    "model_component_blueprint": {
      "type": "object",
      "required": ["version", "mode", "run_id", "source_refs", "components"],
      "additionalProperties": true,
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "mode": { "const": "DRD_MODE" },
        "run_id": { "type": "string", "minLength": 1 },
        "source_refs": { "$ref": "#/$defs/source_refs" },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["component_id", "component_name_zh", "primitive_path", "expected_figma_node_type", "layout_region", "source_refs"],
            "additionalProperties": true,
            "properties": {
              "source_refs": { "$ref": "#/$defs/source_refs" }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
