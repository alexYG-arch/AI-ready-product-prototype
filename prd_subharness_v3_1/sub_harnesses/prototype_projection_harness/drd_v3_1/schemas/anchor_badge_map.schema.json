{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DRD v3.1 Anchor Badge Map",
  "type": "object",
  "required": ["anchor_badge_map"],
  "properties": {
    "anchor_badge_map": {
      "type": "object",
      "required": ["version", "mode", "source_refs", "badges"],
      "properties": {
        "version": { "const": "3.1" },
        "mode": { "const": "DRD_MODE" },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "badges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["badge_id", "target_component_id", "label", "source_refs"],
            "properties": {
              "badge_id": { "type": "string", "minLength": 1 },
              "target_component_id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "source_refs": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
