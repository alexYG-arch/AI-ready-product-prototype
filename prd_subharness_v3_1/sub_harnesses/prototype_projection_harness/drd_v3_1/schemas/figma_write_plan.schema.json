{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prd-harness.local/schemas/figma_write_plan.schema.json",
  "title": "Figma Write Plan",
  "type": "object",
  "required": ["figma_write_plan"],
  "properties": {
    "figma_write_plan": {
      "type": "object",
      "required": ["version", "mode", "run_id", "source_refs", "write_units"],
      "additionalProperties": true,
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "mode": { "const": "DRD_MODE" },
        "run_id": { "type": "string", "minLength": 1 },
        "source_refs": { "$ref": "#/$defs/source_refs" },
        "write_units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["unit_id", "write_kind", "source_refs"],
            "additionalProperties": true,
            "properties": {
              "source_refs": { "$ref": "#/$defs/source_refs" }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
