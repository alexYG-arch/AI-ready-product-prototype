{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prototype Source Coverage Report",
  "type": "object",
  "required": ["source_coverage_report"],
  "properties": {
    "source_coverage_report": {
      "type": "object",
      "required": ["version", "mode", "run_id", "status", "coverage_results", "source_refs"],
      "properties": {
        "version": { "const": "3.1.1" },
        "mode": { "const": "DRD_MODE" },
        "run_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "blocked"] },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "coverage_results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["atom_id", "required", "covered", "source_refs"],
            "properties": {
              "atom_id": { "type": "string", "minLength": 1 },
              "required": { "type": "boolean" },
              "covered": { "type": "boolean" },
              "source_refs": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
