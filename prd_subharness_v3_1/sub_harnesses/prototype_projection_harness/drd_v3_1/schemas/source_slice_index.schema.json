{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prototype Source Slice Index",
  "type": "object",
  "required": ["source_slice_index"],
  "properties": {
    "source_slice_index": {
      "type": "object",
      "required": ["version", "mode", "source_refs", "slices"],
      "properties": {
        "version": { "const": "3.1.1" },
        "mode": { "const": "DRD_MODE" },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "slices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["slice_id", "slice_type", "atom_ids", "source_refs"],
            "properties": {
              "slice_id": { "type": "string", "minLength": 1 },
              "slice_type": { "type": "string", "minLength": 1 },
              "atom_ids": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "source_refs": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
