{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prototype Source Atom",
  "type": "object",
  "required": ["atom_id", "atom_type", "source_refs", "source_text_zh", "required_for_rendering"],
  "properties": {
    "atom_id": { "type": "string", "minLength": 1 },
    "atom_type": { "type": "string", "minLength": 1 },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "source_text_zh": { "type": "string", "minLength": 1 },
    "required_for_rendering": { "type": "boolean" },
    "raw_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "categories": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": true
}
