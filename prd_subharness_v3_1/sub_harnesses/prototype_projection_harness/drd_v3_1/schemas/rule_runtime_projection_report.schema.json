{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rule_runtime_projection_report.schema.json",
  "type": "object",
  "required": ["rule_runtime_projection_report"],
  "properties": {
    "rule_runtime_projection_report": {
      "type": "object",
      "required": ["version", "mode", "status", "checked_artifacts", "missing_runtime_traces", "hidden_python_rules", "source_refs", "rule_trace"],
      "properties": {
        "version": {"const": "3.2.3"},
        "mode": {"const": "DRD_MODE"},
        "status": {"enum": ["pass", "blocked"]},
        "source_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "rule_trace": {"type": "object"},
        "checked_artifacts": {"type": "array", "items": {"type": "object"}},
        "missing_runtime_traces": {"type": "array", "items": {"type": "string"}},
        "hidden_python_rules": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
