{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prd-harness.local/schemas/figma_geometry_audit.schema.json",
  "title": "Figma Geometry Audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["figma_geometry_audit"],
  "properties": {
    "figma_geometry_audit": {
      "type": "object",
      "additionalProperties": true,
      "required": ["version", "mode", "run_id", "audit_source", "source_refs", "rule_trace", "checks", "status"],
      "properties": {
        "version": { "enum": ["3.1.3", "3.1.4"] },
        "mode": { "const": "DRD_MODE" },
        "run_id": { "type": "string", "minLength": 1 },
        "audit_source": { "const": "figma_live_readback_geometry" },
        "status": { "enum": ["pass", "blocked"] },
        "source_refs": { "$ref": "#/$defs/source_refs" },
        "rule_trace": { "$ref": "#/$defs/rule_trace" },
        "checks": {
          "type": "object",
          "required": ["text_outside_scene", "component_outside_scene", "overlap_count", "dense_scene_count", "generic_text_count", "state_matrix_detected", "old_screen_group_count", "hotspots_without_explanation", "carrier_mismatch_count"],
          "additionalProperties": true
        },
        "blocker_findings": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "rule_trace": {
      "type": "object",
      "required": ["rule_ids"],
      "additionalProperties": true,
      "properties": { "rule_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } }
    }
  }
}
