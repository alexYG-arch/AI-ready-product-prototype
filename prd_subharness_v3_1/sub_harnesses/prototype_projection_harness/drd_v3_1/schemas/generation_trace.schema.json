{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prototype Generation Trace",
  "type": "object",
  "required": ["generation_trace"],
  "properties": {
    "generation_trace": {
      "type": "object",
      "required": [
        "trace_id",
        "artifact_id",
        "artifact_path",
        "generator_id",
        "generator_worker_id",
        "generated_at",
        "input_hashes",
        "source_refs",
        "generation_job_queue_ref",
        "generator_families",
        "decisions",
        "model_inference",
        "generation_gaps",
        "output_hash",
        "self_check_result"
      ],
      "properties": {
        "trace_id": { "type": "string", "minLength": 1 },
        "artifact_id": { "type": "string", "minLength": 1 },
        "artifact_path": { "type": "string", "minLength": 1 },
        "generator_id": { "type": "string", "minLength": 1 },
        "generator_worker_id": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "minLength": 1 },
        "input_hashes": { "type": "object" },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "generation_job_queue_ref": { "type": "string", "minLength": 1 },
        "generator_families": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["generator_kind", "generator_id"],
            "properties": {
              "generator_kind": { "enum": ["deterministic", "model"] },
              "generator_id": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": true
          }
        },
        "decisions": { "type": "array" },
        "model_inference": { "type": "object" },
        "generation_gaps": { "type": "array" },
        "output_hash": { "type": "string", "minLength": 1 },
        "self_check_result": { "type": "object" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
