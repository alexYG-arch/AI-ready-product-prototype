{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generated Artifact Manifest",
  "type": "object",
  "required": ["generated_artifact_manifest"],
  "properties": {
    "generated_artifact_manifest": {
      "type": "object",
      "required": ["version", "mode", "run_id", "artifacts"],
      "properties": {
        "version": { "const": "3.1.1" },
        "mode": { "const": "DRD_MODE" },
        "run_id": { "type": "string", "minLength": 1 },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["artifact_id", "path", "generator_id", "trace_id", "hash", "status"],
            "properties": {
              "artifact_id": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 },
              "generator_id": { "type": "string", "minLength": 1 },
              "trace_id": { "type": "string", "minLength": 1 },
              "hash": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
