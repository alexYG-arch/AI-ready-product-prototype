{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Interaction Carrier Map",
  "type": "object",
  "required": ["interaction_carrier_map"],
  "properties": {
    "interaction_carrier_map": {
      "type": "object",
      "required": ["version", "mode", "run_id", "source_refs", "screen_carriers", "state_carriers", "component_carriers", "interaction_carriers"],
      "properties": {
        "version": { "const": "3.1.2" },
        "mode": { "const": "DRD_MODE" },
        "run_id": { "type": "string", "minLength": 1 },
        "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "screen_carriers": { "type": "array", "items": { "type": "object" } },
        "state_carriers": { "type": "array", "items": { "type": "object" } },
        "component_carriers": { "type": "array", "items": { "type": "object" } },
        "interaction_carriers": { "type": "array", "minItems": 1, "items": { "type": "object" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
