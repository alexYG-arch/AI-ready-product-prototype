{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prototype Render Payload",
  "type": "object",
  "required": ["prototype_render_payload"],
  "properties": {
    "prototype_render_payload": {
      "type": "object",
      "required": [
        "version",
        "mode",
        "generated_by",
        "candidate_marker",
        "sample",
        "source_kind",
        "source_refs",
        "design_system",
        "boards",
        "frames",
        "components",
        "interactions",
        "annotations"
      ],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "mode": { "const": "DRD_MODE" },
        "generated_by": {
          "enum": [
            "prototype_artifact_generator_v3_1",
            "prototype_artifact_generator_v3_1_1",
            "prototype_artifact_generator_v3_1_2"
          ]
        },
        "candidate_marker": { "const": "candidate_projection" },
        "sample": { "const": false },
        "source_kind": { "const": "prd_source" },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "design_system": {
          "type": "object",
          "required": ["adapter_id", "color_policy"],
          "properties": {
            "adapter_id": { "const": "SDS_MONOCHROME_ADAPTER_V3_1" },
            "color_policy": { "const": "black_white_gray_only" }
          },
          "additionalProperties": true
        },
        "boards": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/renderable_item" }
        },
        "frames": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/renderable_item" }
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/renderable_item" }
        },
        "interactions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/renderable_item" }
        },
        "annotations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/renderable_item" }
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "renderable_item": {
      "type": "object",
      "required": ["source_refs", "render_eligibility", "candidate_marker"],
      "properties": {
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "render_eligibility": { "const": "renderable" },
        "candidate_marker": { "const": "candidate_projection" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
