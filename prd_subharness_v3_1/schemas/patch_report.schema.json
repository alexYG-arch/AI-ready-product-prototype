{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PRD Harness Patch Report",
  "type": "object",
  "required": ["patch_report"],
  "properties": {
    "patch_report": {
      "type": "object",
      "required": [
        "schema_version",
        "patch_id",
        "run_id",
        "status",
        "summary",
        "root_cause",
        "changed_files",
        "validation",
        "human_review"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "patch_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "sub_harness": { "type": "string" },
        "status": {
          "enum": ["candidate", "applied", "blocked", "changes_requested", "superseded"]
        },
        "summary": { "type": "string", "minLength": 1 },
        "root_cause": { "type": "string", "minLength": 1 },
        "source_artifacts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "changed_files": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "validation": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "remaining_gaps": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "stop_the_line_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "human_review": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
