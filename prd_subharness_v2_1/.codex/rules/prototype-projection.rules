prefix_rule(
    pattern = ["python", "scripts/prd_control/prototypectl.py"],
    decision = "allow",
    justification = "允许运行 prototype projection harness 的离线校验脚本。"
)

prefix_rule(
    pattern = ["python", "scripts/prd_control/harnessctl.py"],
    decision = "allow",
    justification = "继续允许 PRD sub-harness 主校验脚本。"
)

prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "forbidden",
    justification = "禁止递归删除，避免删除 Figma diff evidence、node map、interaction map、patch candidate 或 tombstone。"
)
