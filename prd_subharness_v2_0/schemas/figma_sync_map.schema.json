{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Figma Sync Map",
  "type": "object",
  "required": [
    "figma_sync_map"
  ],
  "properties": {
    "figma_sync_map": {
      "type": "object",
      "required": [
        "version",
        "owner",
        "authority_role",
        "forbidden_as_fact_source",
        "semantic_to_figma_nodes"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "authority_role": {
          "type": "string"
        },
        "forbidden_as_fact_source": {
          "type": "boolean"
        },
        "semantic_to_figma_nodes": {
          "type": "array"
        }
      }
    }
  }
}
